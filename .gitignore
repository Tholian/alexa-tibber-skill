# =============================================================
# alexa-tibber-skill – .gitignore
# =============================================================

# -------------------------------------------------------------
# Gradle
# -------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Gradle wrapper (nur die JAR einchecken, nicht den Cache)
gradle-app.setting
.gradletasknamecache

# -------------------------------------------------------------
# Maven (falls jemand das Projekt mit Maven bauen möchte)
# -------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -------------------------------------------------------------
# Java
# -------------------------------------------------------------
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# -------------------------------------------------------------
# IntelliJ IDEA
# -------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/aws.xml
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.classpath
.idea/uiDesigner.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/modules.xml
.idea/*.iml
.idea/modules/

# -------------------------------------------------------------
# Eclipse
# -------------------------------------------------------------
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# -------------------------------------------------------------
# VS Code
# -------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# -------------------------------------------------------------
# NetBeans
# -------------------------------------------------------------
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# -------------------------------------------------------------
# Spring Boot
# -------------------------------------------------------------
spring-shell.log

# -------------------------------------------------------------
# Logs
# -------------------------------------------------------------
*.log
logs/
log/

# -------------------------------------------------------------
# Sicherheit – NIEMALS einchecken!
# -------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks
*.keystore
nginx/certs/

# -------------------------------------------------------------
# Betriebssystem
# -------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -------------------------------------------------------------
# Docker
# -------------------------------------------------------------
.docker/

# -------------------------------------------------------------
# AI-Entwicklungsartefakte (Specs, Pläne – nicht für Repository)
# -------------------------------------------------------------
docs/superpowers/

# -------------------------------------------------------------
# Temporäre Dateien
# -------------------------------------------------------------
*.tmp
*.bak
*.swp
*.swo
*~.nib
local.properties
